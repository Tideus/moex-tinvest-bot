[Unit]
Description=Send MOEX/T-Invest reports after the evening session

[Timer]
OnCalendar=*-*-* 23:55:00 Europe/Moscow
# No implicit replay; an explicit delayed run selects the last closed date in Moscow.
Persistent=false
RandomizedDelaySec=20s
AccuracySec=1s
Unit=moex-tinvest-daily-report.service

[Install]
WantedBy=timers.target
