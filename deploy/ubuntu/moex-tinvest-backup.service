[Unit]
Description=MOEX bot daily state backup before retention cleanup
Before=moex-tinvest-maintenance.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/bash /opt/moex-tinvest-bot/scripts/ubuntu/backup.sh
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# mode=ro protects database contents; SQLite may still need WAL/SHM sidecars.
# A read-only mount breaks snapshots of quiescent WAL databases without sidecars.
ReadWritePaths=/var/lib/moex-tinvest-bot /var/backups /var/lib/moex-tinvest-control/prod-session.lock
